<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🎡 Roleta Admin — isaroza_</title>
  <style>
    :root {
      --bg: #0d0d14;
      --surface: #16161f;
      --surface2: #1e1e2e;
      --border: #2a2a3d;
      --accent: #d108ac;
      --accent2: #7b2fff;
      --text: #e8e8f0;
      --muted: #888;
      --success: #43a047;
      --danger: #e53935;
      --warn: #f77f00;
      --radius: 12px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    /* ── Header ── */
    header {
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      padding: 16px 24px;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    header h1 { font-size: 1.25rem; font-weight: 700; }
    header small { opacity: .7; font-size: .8rem; }

    /* ── Login overlay ── */
    #loginOverlay {
      position: fixed; inset: 0;
      background: var(--bg);
      display: flex; align-items: center; justify-content: center;
      z-index: 9999;
    }
    .login-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 36px 32px;
      width: min(400px, 92vw);
      display: flex; flex-direction: column; gap: 16px;
    }
    .login-card h2 { text-align: center; }

    /* ── Layout ── */
    .app { display: none; flex-direction: column; min-height: calc(100vh - 60px); }
    .app.visible { display: flex; }

    /* ── Tabs ── */
    nav.tabs {
      display: flex; overflow-x: auto; gap: 2px;
      background: var(--surface); border-bottom: 1px solid var(--border);
      padding: 0 8px;
    }
    nav.tabs button {
      background: transparent; color: var(--muted);
      border: none; cursor: pointer;
      padding: 14px 18px; font-size: .9rem; font-weight: 600;
      border-bottom: 3px solid transparent;
      white-space: nowrap; transition: all .2s;
    }
    nav.tabs button.active { color: var(--text); border-bottom-color: var(--accent); }
    nav.tabs button:hover:not(.active) { color: var(--text); }

    /* ── Content ── */
    .content { padding: 24px; max-width: 900px; width: 100%; margin: 0 auto; }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    /* ── Cards ── */
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px;
      margin-bottom: 16px;
    }
    .card h3 { font-size: 1rem; margin-bottom: 14px; color: var(--accent); }

    /* ── Grid form ── */
    .form-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
    .field { display: flex; flex-direction: column; gap: 6px; }
    label { font-size: .8rem; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: .5px; }
    input[type=text], input[type=number], input[type=password], select, input[type=url] {
      background: var(--surface2);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 9px 12px;
      border-radius: 8px;
      font-size: .9rem;
      outline: none;
      transition: border-color .2s;
      width: 100%;
    }
    input:focus, select:focus { border-color: var(--accent); }
    input[type=range] { accent-color: var(--accent); width: 100%; }
    input[type=checkbox] { accent-color: var(--accent); width: 16px; height: 16px; cursor: pointer; }
    .check-row { display: flex; align-items: center; gap: 10px; font-size: .9rem; }

    /* ── Buttons ── */
    .btn {
      padding: 9px 18px; border-radius: 8px; border: none;
      cursor: pointer; font-weight: 700; font-size: .85rem;
      transition: opacity .2s, transform .1s;
    }
    .btn:hover { opacity: .9; }
    .btn:active { transform: scale(.97); }
    .btn-primary { background: var(--accent); color: #fff; }
    .btn-success { background: var(--success); color: #fff; }
    .btn-danger  { background: var(--danger); color: #fff; }
    .btn-warn    { background: var(--warn); color: #fff; }
    .btn-ghost   { background: var(--surface2); color: var(--text); border: 1px solid var(--border); }
    .btn-sm { padding: 6px 12px; font-size: .8rem; }

    /* ── Actions row ── */
    .actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; }

    /* ── Toast ── */
    #toast {
      position: fixed; bottom: 24px; right: 24px;
      background: var(--surface2); border: 1px solid var(--border);
      padding: 12px 20px; border-radius: 10px;
      font-size: .9rem; opacity: 0;
      transition: opacity .3s; pointer-events: none; z-index: 9998;
      max-width: 320px;
    }
    #toast.show { opacity: 1; }
    #toast.ok  { border-color: var(--success); }
    #toast.err { border-color: var(--danger); }

    /* ── Image grid ── */
    .img-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 12px; }
    .img-tile {
      background: var(--surface2); border: 2px solid var(--border);
      border-radius: 10px; overflow: hidden;
      display: flex; flex-direction: column; align-items: center;
      padding: 8px; gap: 6px; position: relative;
    }
    .img-tile img { width: 100%; height: 80px; object-fit: contain; border-radius: 6px; }
    .img-tile .name { font-size: .7rem; color: var(--muted); text-align: center; word-break: break-all; }
    .img-tile .del-btn {
      position: absolute; top: 4px; right: 4px;
      background: var(--danger); border: none; color: #fff;
      border-radius: 50%; width: 20px; height: 20px;
      cursor: pointer; font-size: .75rem; display: flex; align-items: center; justify-content: center;
    }

    /* ── Slot grid ── */
    .slot-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 14px; }
    .slot-card {
      background: var(--surface2); border: 1px solid var(--border);
      border-radius: 10px; padding: 12px;
      display: flex; flex-direction: column; align-items: center; gap: 8px;
    }
    .slot-card img { width: 100%; height: 100px; object-fit: contain; border-radius: 6px; }
    .slot-card .slot-name { font-size: .85rem; font-weight: 700; color: var(--accent); }
    .slot-card .slot-actions { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; }

    /* ── Drop zone ── */
    .dropzone {
      border: 2px dashed var(--border); border-radius: 10px;
      padding: 28px; text-align: center; cursor: pointer;
      color: var(--muted); font-size: .9rem;
      transition: border-color .2s;
    }
    .dropzone:hover, .dropzone.drag { border-color: var(--accent); color: var(--text); }

    /* ── Badge ── */
    .badge {
      display: inline-block; padding: 2px 8px; border-radius: 20px;
      font-size: .75rem; font-weight: 700;
    }
    .badge-ok  { background: #1b3a1c; color: #a5d6a7; }
    .badge-err { background: #3b1010; color: #ef9a9a; }

    /* ── Spinner ── */
    .spinner {
      display: inline-block; width: 16px; height: 16px;
      border: 2px solid var(--border); border-top-color: var(--accent);
      border-radius: 50%; animation: spin .6s linear infinite; vertical-align: middle;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .sep { border: none; border-top: 1px solid var(--border); margin: 16px 0; }
    .info { font-size: .8rem; color: var(--muted); line-height: 1.5; }
    .code { font-family: monospace; background: var(--surface2); padding: 2px 6px; border-radius: 4px; font-size: .8rem; }
  </style>
</head>
<body>

<!-- Login -->
<div id="loginOverlay">
  <div class="login-card">
    <h2>🎡 Roleta Admin</h2>
    <p class="info" style="text-align:center">Digite a chave secreta (<code>ADMIN_SECRET</code>) para acessar.</p>
    <div class="field">
      <label>Chave secreta</label>
      <input type="password" id="secretInput" placeholder="••••••••" autocomplete="current-password">
    </div>
    <div class="field">
      <label>URL do backend</label>
      <input type="url" id="backendUrl" placeholder="https://seu-app.onrender.com" autocomplete="off">
    </div>
    <button class="btn btn-primary" id="loginBtn">Entrar</button>
    <p id="loginErr" style="color:var(--danger);font-size:.85rem;text-align:center;display:none">Chave incorreta ou backend inacessível.</p>
  </div>
</div>

<!-- Header -->
<header>
  <span style="font-size:1.5rem">🎡</span>
  <div>
    <h1>Roleta Admin <span style="opacity:.6;font-size:.85rem">isaroza_</span></h1>
    <small id="headerUrl"></small>
  </div>
  <div style="margin-left:auto;display:flex;gap:8px;align-items:center">
    <span id="statusBadge" class="badge badge-ok">conectado</span>
    <span id="sseBadge" class="badge" style="background:#1b2a3b;color:#64b5f6;display:none">📡 live</span>
    <button class="btn btn-ghost btn-sm" id="logoutBtn">Sair</button>
  </div>
</header>

<!-- App -->
<div class="app" id="app">
  <nav class="tabs">
    <button class="active" data-tab="config">⚙️ Geral</button>
    <button data-tab="sons">🎵 Sons</button>
    <button data-tab="arena">🐾 Arena</button>
    <button data-tab="imagens">🖼️ Imagens</button>
    <button data-tab="filmes">🎬 Filmes</button>
    <button data-tab="estado">📦 Estado</button>
  </nav>

  <div class="content">

    <!-- ═══ ABA: GERAL ═══ -->
    <div class="tab-panel active" id="tab-config">
      <div class="card">
        <h3>⚙️ Configurações Gerais</h3>
        <div class="form-grid">
          <div class="field">
            <label>Título da roleta</label>
            <input type="text" id="cfg-titulo" placeholder="Rindo e Apoiando !!">
          </div>
          <div class="field">
            <label>Canal Twitch</label>
            <input type="text" id="cfg-channel" placeholder="isaroza_">
          </div>
          <div class="field">
            <label>Tempo padrão de giro (seg)</label>
            <input type="number" id="cfg-tempo" min="1" max="120" placeholder="5">
          </div>
          <div class="field">
            <label>Modo de cor</label>
            <select id="cfg-modoCor">
              <option value="colorido">🏳‍🌈 Colorido</option>
              <option value="neutro">⚪ Neutro</option>
            </select>
          </div>
          <div class="field">
            <label>Tema ativo</label>
            <select id="cfg-tema">
              <option>Padrão Rosa</option><option>Oceano</option><option>Floresta</option>
              <option>Pôr do Sol</option><option>Galáxia</option><option>Fogo</option>
              <option>Gelo</option><option>Ouro Negro</option><option>Cyberpunk</option><option>Cereja</option>
            </select>
          </div>
        </div>
        <hr class="sep">
        <div class="form-grid">
          <div class="check-row field">
            <input type="checkbox" id="cfg-autoRemover">
            <label for="cfg-autoRemover" style="text-transform:none;font-size:.9rem">Remover vencedor automaticamente</label>
          </div>
          <div class="check-row field">
            <input type="checkbox" id="cfg-autoOcultar">
            <label for="cfg-autoOcultar" style="text-transform:none;font-size:.9rem">Ocultar painel ao girar</label>
          </div>
          <div class="check-row field">
            <input type="checkbox" id="cfg-temaRotar">
            <label for="cfg-temaRotar" style="text-transform:none;font-size:.9rem">Trocar tema automaticamente</label>
          </div>
        </div>
        <div class="actions">
          <button class="btn btn-primary" id="saveCfg">💾 Salvar configurações</button>
        </div>
      </div>
    </div>

    <!-- ═══ ABA: SONS ═══ -->
    <div class="tab-panel" id="tab-sons">
      <div class="card">
        <h3>🎵 Configurações de Som</h3>
        <div class="form-grid">
          <div class="field">
            <label>Música selecionada</label>
            <select id="son-musica"></select>
          </div>
        </div>
        <hr class="sep">
        <div class="form-grid">
          <div class="field">
            <label>Volume da música: <span id="lbl-volMusica">10%</span></label>
            <input type="range" id="son-volMusica" min="0" max="1" step="0.01">
          </div>
          <div class="field">
            <label>Volume do tick: <span id="lbl-volTick">12%</span></label>
            <input type="range" id="son-volTick" min="0" max="1" step="0.01">
          </div>
        </div>
        <hr class="sep">
        <div class="check-row">
          <input type="checkbox" id="son-tocarAoGirar">
          <label for="son-tocarAoGirar" style="text-transform:none;font-size:.9rem">Tocar música automaticamente ao girar</label>
        </div>
        <div class="actions">
          <button class="btn btn-primary" id="saveSons">💾 Salvar sons</button>
        </div>
      </div>
    </div>

    <!-- ═══ ABA: ARENA ═══ -->
    <div class="tab-panel" id="tab-arena">
      <div class="card">
        <h3>🐾 Configurações da Arena de Bonecos</h3>
        <p class="info" style="margin-bottom:14px">
          Usuários que digitam <span class="code">!entrar</span> no chat aparecem como bonecos na tela.
        </p>
        <div class="form-grid">
          <div class="field">
            <label>Cooldown por usuário (ms)</label>
            <input type="number" id="ar-userCooldown" min="0" placeholder="15000">
          </div>
          <div class="field">
            <label>Cooldown global entre spawns (ms)</label>
            <input type="number" id="ar-globalCooldown" min="0" placeholder="5000">
          </div>
          <div class="field">
            <label>Máximo de bonecos simultâneos</label>
            <input type="number" id="ar-maxBonecos" min="1" max="200" placeholder="30">
          </div>
          <div class="field">
            <label>Posição dos bonecos</label>
            <select id="ar-posicao">
              <option value="frente">🔝 À frente da roleta</option>
              <option value="atras">🔙 Atrás da roleta</option>
              <option value="desativado">🚫 Desativado</option>
            </select>
          </div>
        </div>
        <div class="actions">
          <button class="btn btn-primary" id="saveArena">💾 Salvar arena</button>
        </div>
      </div>
    </div>

    <!-- ═══ ABA: IMAGENS ═══ -->
    <div class="tab-panel" id="tab-imagens">

      <!-- Imagens estáticas -->
      <div class="card">
        <h3>🖼️ Imagens Estáticas</h3>
        <p class="info" style="margin-bottom:14px">
          Substitua as imagens da roleta (fundo, centro, personagens). <br>
          <b>null</b> = usa a imagem original do repositório GitHub Pages.
        </p>
        <div class="slot-grid" id="slotGrid">
          <div style="color:var(--muted)" class="info">Carregando slots…</div>
        </div>
      </div>

      <!-- Bonecos -->
      <div class="card">
        <h3>🐾 Bonecos da Arena</h3>
        <p class="info" style="margin-bottom:14px">
          Imagens usadas aleatoriamente quando um espectador digita <span class="code">!entrar</span>.
        </p>
        <label class="dropzone" id="bonemosDropzone">
          <input type="file" id="bonemosInput" multiple accept="image/*" style="display:none">
          📂 Clique ou arraste imagens aqui (PNG/JPG/WebP, máx 5 MB cada)
        </label>
        <div class="actions">
          <button class="btn btn-success btn-sm" id="uploadBonecos">⬆️ Enviar selecionados</button>
          <button class="btn btn-ghost btn-sm" id="refreshBonecos">🔄 Recarregar lista</button>
        </div>
        <hr class="sep">
        <div class="img-grid" id="bonecoGrid">
          <div class="info">Carregando…</div>
        </div>
      </div>
    </div>

    <!-- ═══ ABA: FILMES ═══ -->
    <div class="tab-panel" id="tab-filmes">
      <div class="card">
        <h3>🎬 Configurações de Filmes</h3>
        <div class="form-grid">
          <div class="field" style="grid-column:1/-1">
            <label>URL da API de filmes (backend Render)</label>
            <input type="url" id="fil-apiUrl" placeholder="https://meu-api-filmes.onrender.com/filmes">
          </div>
          <div class="field">
            <label>Categoria padrão</label>
            <input type="text" id="fil-categoria" placeholder="Ação, Terror…">
          </div>
        </div>
        <hr class="sep">
        <div class="check-row" style="margin-bottom:14px">
          <input type="checkbox" id="fil-votosAtivo">
          <label for="fil-votosAtivo" style="text-transform:none;font-size:.9rem">Distribuir tickets por contagem de votos</label>
        </div>
        <div class="form-grid" id="votosConfig">
          <div class="field">
            <label>Votos por base</label>
            <input type="number" id="fil-votosBase" min="1" placeholder="50">
          </div>
          <div class="field">
            <label>Tickets por bloco de votos</label>
            <input type="number" id="fil-ticketsPorVotos" min="1" placeholder="1">
          </div>
          <div class="field">
            <label>Tickets mínimos</label>
            <input type="number" id="fil-ticketsMin" min="1" placeholder="1">
          </div>
          <div class="field">
            <label>Tickets máximos</label>
            <input type="number" id="fil-ticketsMax" min="1" placeholder="20">
          </div>
        </div>
        <div class="actions">
          <button class="btn btn-primary" id="saveFilmes">💾 Salvar filmes</button>
          <button class="btn btn-ghost" id="testProxy">🔌 Testar conexão da API</button>
        </div>
        <p id="proxyResult" class="info" style="margin-top:10px"></p>
      </div>
    </div>

    <!-- ═══ ABA: ESTADO ═══ -->
    <div class="tab-panel" id="tab-estado">
      <div class="card">
        <h3>📦 Exportar / Importar Estado</h3>
        <p class="info" style="margin-bottom:14px">
          Faça backup completo das configurações ou restaure de um backup anterior.
        </p>
        <div class="actions">
          <button class="btn btn-ghost" id="exportState">⬇️ Exportar JSON</button>
          <button class="btn btn-ghost" id="importStateBtn">⬆️ Importar JSON</button>
          <input type="file" id="importStateFile" accept=".json" style="display:none">
        </div>
        <hr class="sep">
        <h3 style="color:var(--danger)">🗑️ Reset completo</h3>
        <p class="info" style="margin-bottom:12px">Apaga todas as configurações e volta aos valores padrão.</p>
        <button class="btn btn-danger" id="resetState">⚠️ Resetar tudo</button>
      </div>

      <div class="card">
        <h3>🔍 Estado atual (JSON)</h3>
        <textarea id="stateViewer" readonly style="
          width:100%; height:320px; background:var(--surface2);
          color:#a8ff78; border:1px solid var(--border);
          border-radius:8px; padding:12px; font-family:monospace;
          font-size:.8rem; resize:vertical;
        "></textarea>
        <div class="actions">
          <button class="btn btn-ghost btn-sm" id="refreshState">🔄 Atualizar</button>
        </div>
      </div>
    </div>

  </div><!-- /content -->
</div><!-- /app -->

<div id="toast"></div>

<script>
// ──────────────────────────────────────────────────────────────────────────────
// ESTADO GLOBAL
// ──────────────────────────────────────────────────────────────────────────────
let API = '';
let SECRET = '';

// ──────────────────────────────────────────────────────────────────────────────
// UTILS
// ──────────────────────────────────────────────────────────────────────────────
function toast(msg, type = 'ok') {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.className = `show ${type}`;
  clearTimeout(el._t);
  el._t = setTimeout(() => el.className = '', 3000);
}

async function api(path, opts = {}) {
  const res = await fetch(`${API}${path}`, {
    headers: {
      'Content-Type': opts.body instanceof FormData ? undefined : 'application/json',
      'Authorization': `Bearer ${SECRET}`,
      ...opts.headers,
    },
    ...opts,
    body: opts.body instanceof FormData ? opts.body : opts.body ? JSON.stringify(opts.body) : undefined,
  });
  const data = await res.json();
  if (!data.ok) throw new Error(data.error || 'Erro desconhecido');
  return data;
}

// ──────────────────────────────────────────────────────────────────────────────
// LOGIN
// ──────────────────────────────────────────────────────────────────────────────
const savedApi = localStorage.getItem('roleta_api') || '';
const savedSecret = localStorage.getItem('roleta_secret') || '';
if (savedApi) document.getElementById('backendUrl').value = savedApi;
if (savedSecret) document.getElementById('secretInput').value = savedSecret;

async function doLogin(url, secret) {
  url = url.trim().replace(/\/$/, '');
  secret = secret.trim();
  if (!url || !secret) return;
  try {
    const res = await fetch(`${url}/api/config`, {
      headers: { Authorization: `Bearer ${secret}` }
    });
    if (!res.ok) throw new Error('Não autorizado');
    // Seta globais ANTES de qualquer outra coisa
    API = url;
    SECRET = secret;
    localStorage.setItem('roleta_api', API);
    localStorage.setItem('roleta_secret', SECRET);
    document.getElementById('loginOverlay').style.display = 'none';
    document.getElementById('app').classList.add('visible');
    document.getElementById('headerUrl').textContent = API;
    init();
  } catch {
    document.getElementById('loginErr').style.display = 'block';
  }
}

document.getElementById('loginBtn').onclick = () => {
  const url = document.getElementById('backendUrl').value;
  const secret = document.getElementById('secretInput').value;
  doLogin(url, secret);
};

document.getElementById('secretInput').onkeydown = e => { if (e.key === 'Enter') document.getElementById('loginBtn').click(); };

document.getElementById('logoutBtn').onclick = () => {
  localStorage.removeItem('roleta_api');
  localStorage.removeItem('roleta_secret');
  location.reload();
};

// ──────────────────────────────────────────────────────────────────────────────
// TABS
// ──────────────────────────────────────────────────────────────────────────────
document.querySelectorAll('nav.tabs button').forEach(btn => {
  btn.onclick = () => {
    document.querySelectorAll('nav.tabs button').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById(`tab-${btn.dataset.tab}`).classList.add('active');
    if (btn.dataset.tab === 'imagens') { loadBonecos(); loadStaticSlots(); }
    if (btn.dataset.tab === 'estado') loadStateViewer();
  };
});

// ──────────────────────────────────────────────────────────────────────────────
// INIT — carrega todas as seções
// ──────────────────────────────────────────────────────────────────────────────
async function init() {
  await Promise.all([loadConfig(), loadSons(), loadArena(), loadFilmes()]);
  connectSSE();
}

// ──────────────────────────────────────────────────────────────────────────────
// SSE — recebe confirmação de que o save chegou na roleta
// ──────────────────────────────────────────────────────────────────────────────
function connectSSE() {
  const badge = document.getElementById('sseBadge');
  try {
    const sse = new EventSource(`${API}/api/events`);
    sse.onopen = () => { badge.style.display = 'inline-block'; };
    sse.onerror = () => { badge.style.display = 'none'; setTimeout(connectSSE, 5000); sse.close(); };
    // Quando a roleta recebe um update, o painel não precisa reagir —
    // mas podemos mostrar um toast de confirmação
    ['config','sons','arena','imagens','bonecos'].forEach(ev => {
      sse.addEventListener(ev, () => {
        badge.style.display = 'inline-block';
      });
    });
  } catch(e) { badge.style.display = 'none'; }
}

// ──────────────────────────────────────────────────────────────────────────────
// ABA GERAL
// ──────────────────────────────────────────────────────────────────────────────
async function loadConfig() {
  const { data } = await api('/api/config');
  document.getElementById('cfg-titulo').value = data.titulo || '';
  document.getElementById('cfg-channel').value = data.channelName || '';
  document.getElementById('cfg-tempo').value = data.tempoPadrao || 5;
  document.getElementById('cfg-modoCor').value = data.modoCor || 'colorido';
  document.getElementById('cfg-tema').value = data.temaAtivo || 'Padrão Rosa';
  document.getElementById('cfg-autoRemover').checked = !!data.autoRemoverVencedor;
  document.getElementById('cfg-autoOcultar').checked = !!data.autoOcultarPainel;
  document.getElementById('cfg-temaRotar').checked = !!data.temaAutoRotar;
}

document.getElementById('saveCfg').onclick = async () => {
  try {
    await api('/api/config', {
      method: 'PATCH',
      body: {
        titulo: document.getElementById('cfg-titulo').value,
        channelName: document.getElementById('cfg-channel').value,
        tempoPadrao: parseInt(document.getElementById('cfg-tempo').value),
        modoCor: document.getElementById('cfg-modoCor').value,
        temaAtivo: document.getElementById('cfg-tema').value,
        autoRemoverVencedor: document.getElementById('cfg-autoRemover').checked,
        autoOcultarPainel: document.getElementById('cfg-autoOcultar').checked,
        temaAutoRotar: document.getElementById('cfg-temaRotar').checked,
      }
    });
    toast('✅ Configurações salvas!');
  } catch (e) { toast('❌ ' + e.message, 'err'); }
};

// ──────────────────────────────────────────────────────────────────────────────
// ABA SONS
// ──────────────────────────────────────────────────────────────────────────────
const MUSICAS_NAMES = [
  'Silvio Santos (padrão)','Sou humano (gospel)','Como zaquel (gospel)',
  'Noites traiçoeiras (gospel)','Ragatanga','We Are the Champions',
  'Rock Balboa','Rock Balboa 2','PSY – Gangnam Style','Roleta Vira e Volta',
  'Missão Impossível','Quem é esse? (gospel)','Tango balango',
  'Jesus Cristo (gospel)','Butterfly','Uni Duni Tê','No Baile Nois é Mídia',
  'Música padrão de sorteio',
];

async function loadSons() {
  const { data } = await api('/api/sons');
  const sel = document.getElementById('son-musica');
  sel.innerHTML = MUSICAS_NAMES.map((n, i) => `<option value="${i}">${i} – ${n}</option>`).join('');
  sel.value = data.musicaSelecionada;
  const vm = document.getElementById('son-volMusica');
  vm.value = data.volumeMusica;
  document.getElementById('lbl-volMusica').textContent = Math.round(data.volumeMusica * 100) + '%';
  const vt = document.getElementById('son-volTick');
  vt.value = data.volumeTick;
  document.getElementById('lbl-volTick').textContent = Math.round(data.volumeTick * 100) + '%';
  document.getElementById('son-tocarAoGirar').checked = !!data.tocarMusicaAoGirar;
}

document.getElementById('son-volMusica').oninput = e =>
  document.getElementById('lbl-volMusica').textContent = Math.round(e.target.value * 100) + '%';
document.getElementById('son-volTick').oninput = e =>
  document.getElementById('lbl-volTick').textContent = Math.round(e.target.value * 100) + '%';

document.getElementById('saveSons').onclick = async () => {
  try {
    await api('/api/sons', {
      method: 'PATCH',
      body: {
        musicaSelecionada: parseInt(document.getElementById('son-musica').value),
        volumeMusica: parseFloat(document.getElementById('son-volMusica').value),
        volumeTick: parseFloat(document.getElementById('son-volTick').value),
        tocarMusicaAoGirar: document.getElementById('son-tocarAoGirar').checked,
      }
    });
    toast('✅ Sons salvos!');
  } catch (e) { toast('❌ ' + e.message, 'err'); }
};

// ──────────────────────────────────────────────────────────────────────────────
// ABA ARENA
// ──────────────────────────────────────────────────────────────────────────────
async function loadArena() {
  const { data } = await api('/api/arena');
  document.getElementById('ar-userCooldown').value = data.userCooldown;
  document.getElementById('ar-globalCooldown').value = data.globalCooldown;
  document.getElementById('ar-maxBonecos').value = data.maxBonecos;
  document.getElementById('ar-posicao').value = data.posicaoBoneco;
}

document.getElementById('saveArena').onclick = async () => {
  try {
    await api('/api/arena', {
      method: 'PATCH',
      body: {
        userCooldown: parseInt(document.getElementById('ar-userCooldown').value),
        globalCooldown: parseInt(document.getElementById('ar-globalCooldown').value),
        maxBonecos: parseInt(document.getElementById('ar-maxBonecos').value),
        posicaoBoneco: document.getElementById('ar-posicao').value,
      }
    });
    toast('✅ Arena salva!');
  } catch (e) { toast('❌ ' + e.message, 'err'); }
};

// ──────────────────────────────────────────────────────────────────────────────
// ABA IMAGENS — Slots estáticos
// ──────────────────────────────────────────────────────────────────────────────
const SLOT_LABELS = {
  centro:  'Centro da roleta (centro.png)',
  leoeisa: 'Fundo desfocado (leoeisa.png)',
  back:    'Fundo painel oculto (back.png)',
  gato1:   'Fundo do chat (gato1.png)',
  will:    'Favicon (will.png)',
};

async function loadStaticSlots() {
  const { data } = await api('/api/imagens/estaticas');
  const grid = document.getElementById('slotGrid');
  grid.innerHTML = Object.keys(SLOT_LABELS).map(slot => `
    <div class="slot-card" id="slot-${slot}">
      <div class="slot-name">${SLOT_LABELS[slot]}</div>
      <img src="${data[slot] || 'data:image/svg+xml,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'100\' height=\'100\'><rect width=\'100%\' height=\'100%\' fill=\'%231e1e2e\'/><text x=\'50%\' y=\'50%\' dominant-baseline=\'middle\' text-anchor=\'middle\' fill=\'%23888\' font-size=\'12\'>original</text></svg>'}"
           alt="${slot}" onerror="this.style.display='none'">
      <div class="slot-actions">
        <label class="btn btn-ghost btn-sm" style="cursor:pointer">
          📂 Trocar
          <input type="file" accept="image/*" style="display:none"
            onchange="uploadStaticSlot('${slot}', this)">
        </label>
        ${data[slot] ? `<button class="btn btn-danger btn-sm" onclick="deleteStaticSlot('${slot}')">🗑️</button>` : ''}
      </div>
      ${data[slot] ? `<a href="${data[slot]}" target="_blank" class="info" style="font-size:.75rem">ver atual</a>` : '<span class="info" style="font-size:.75rem">usando original</span>'}
    </div>
  `).join('');
}

async function uploadStaticSlot(slot, input) {
  const file = input.files[0];
  if (!file) return;
  const fd = new FormData();
  fd.append('file', file);
  try {
    await fetch(`${API}/api/imagens/estaticas/${slot}`, {
      method: 'POST',
      headers: { Authorization: `Bearer ${SECRET}` },
      body: fd,
    }).then(r => r.json()).then(d => { if (!d.ok) throw new Error(d.error); });
    toast(`✅ Slot "${slot}" atualizado!`);
    loadStaticSlots();
  } catch (e) { toast('❌ ' + e.message, 'err'); }
}

async function deleteStaticSlot(slot) {
  if (!confirm(`Remover imagem customizada do slot "${slot}"?`)) return;
  try {
    await api(`/api/imagens/estaticas/${slot}`, { method: 'DELETE' });
    toast(`🗑️ Slot "${slot}" resetado.`);
    loadStaticSlots();
  } catch (e) { toast('❌ ' + e.message, 'err'); }
}

// ──────────────────────────────────────────────────────────────────────────────
// ABA IMAGENS — Bonecos
// ──────────────────────────────────────────────────────────────────────────────
const bonemosInput = document.getElementById('bonemosInput');
const dropzone = document.getElementById('bonemosDropzone');

dropzone.onclick = () => bonemosInput.click();
dropzone.ondragover = e => { e.preventDefault(); dropzone.classList.add('drag'); };
dropzone.ondragleave = () => dropzone.classList.remove('drag');
dropzone.ondrop = e => {
  e.preventDefault(); dropzone.classList.remove('drag');
  bonemosInput.files = e.dataTransfer.files;
  renderSelectedFiles();
};
bonemosInput.onchange = renderSelectedFiles;

function renderSelectedFiles() {
  const count = bonemosInput.files.length;
  dropzone.querySelector('span') && (dropzone.querySelector('span').textContent = '');
  dropzone.childNodes[1].textContent = count
    ? `${count} arquivo(s) selecionado(s). Clique em "Enviar".`
    : '📂 Clique ou arraste imagens aqui (PNG/JPG/WebP, máx 5 MB cada)';
}

document.getElementById('uploadBonecos').onclick = async () => {
  const files = bonemosInput.files;
  if (!files.length) { toast('Selecione imagens primeiro.', 'err'); return; }
  const fd = new FormData();
  [...files].forEach(f => fd.append('files', f));
  try {
    const res = await fetch(`${API}/api/imagens/bonecos`, {
      method: 'POST',
      headers: { Authorization: `Bearer ${SECRET}` },
      body: fd,
    }).then(r => r.json());
    if (!res.ok) throw new Error(res.error);
    toast(`✅ ${res.uploaded.length} boneco(s) enviado(s)!`);
    bonemosInput.value = '';
    loadBonecos();
  } catch (e) { toast('❌ ' + e.message, 'err'); }
};

document.getElementById('refreshBonecos').onclick = loadBonecos;

async function loadBonecos() {
  const grid = document.getElementById('bonecoGrid');
  grid.innerHTML = '<div class="info"><span class="spinner"></span> Carregando…</div>';
  try {
    const { data } = await api('/api/imagens/bonecos');
    if (!data.length) { grid.innerHTML = '<div class="info">Nenhum boneco cadastrado ainda.</div>'; return; }
    grid.innerHTML = data.map(b => `
      <div class="img-tile">
        <img src="${b.url}" alt="${b.filename}" loading="lazy">
        <div class="name">${b.filename}</div>
        <button class="del-btn" title="Remover" onclick="deleteBoneco('${b.filename}')">×</button>
      </div>
    `).join('');
  } catch (e) { grid.innerHTML = `<div class="info" style="color:var(--danger)">${e.message}</div>`; }
}

async function deleteBoneco(filename) {
  if (!confirm(`Remover boneco "${filename}"?`)) return;
  try {
    await api(`/api/imagens/bonecos/${encodeURIComponent(filename)}`, { method: 'DELETE' });
    toast('🗑️ Boneco removido.');
    loadBonecos();
  } catch (e) { toast('❌ ' + e.message, 'err'); }
}

// ──────────────────────────────────────────────────────────────────────────────
// ABA FILMES
// ──────────────────────────────────────────────────────────────────────────────
async function loadFilmes() {
  const { data } = await api('/api/filmes/config');
  document.getElementById('fil-apiUrl').value = data.apiUrl || '';
  document.getElementById('fil-categoria').value = data.categoriaPadrao || '';
  document.getElementById('fil-votosAtivo').checked = !!data.votosAtivo;
  document.getElementById('fil-votosBase').value = data.votosBase || 50;
  document.getElementById('fil-ticketsPorVotos').value = data.ticketsPorVotos || 1;
  document.getElementById('fil-ticketsMin').value = data.ticketsMin || 1;
  document.getElementById('fil-ticketsMax').value = data.ticketsMax || 20;
}

document.getElementById('saveFilmes').onclick = async () => {
  try {
    await api('/api/filmes/config', {
      method: 'PATCH',
      body: {
        apiUrl: document.getElementById('fil-apiUrl').value,
        categoriaPadrao: document.getElementById('fil-categoria').value,
        votosAtivo: document.getElementById('fil-votosAtivo').checked,
        votosBase: parseInt(document.getElementById('fil-votosBase').value),
        ticketsPorVotos: parseInt(document.getElementById('fil-ticketsPorVotos').value),
        ticketsMin: parseInt(document.getElementById('fil-ticketsMin').value),
        ticketsMax: parseInt(document.getElementById('fil-ticketsMax').value),
      }
    });
    toast('✅ Config de filmes salva!');
  } catch (e) { toast('❌ ' + e.message, 'err'); }
};

document.getElementById('testProxy').onclick = async () => {
  const el = document.getElementById('proxyResult');
  el.textContent = '⏳ Testando…';
  try {
    const res = await fetch(`${API}/api/filmes/proxy`, {
      headers: { Authorization: `Bearer ${SECRET}` }
    });
    const data = await res.json();
    el.textContent = data.ok === false
      ? `❌ ${data.error}`
      : `✅ API respondeu! ${Array.isArray(data) ? data.length + ' filmes encontrados.' : 'OK'}`;
  } catch (e) { el.textContent = '❌ ' + e.message; }
};

// ──────────────────────────────────────────────────────────────────────────────
// ABA ESTADO
// ──────────────────────────────────────────────────────────────────────────────
async function loadStateViewer() {
  try {
    const { data } = await api('/api/estado');
    document.getElementById('stateViewer').value = JSON.stringify(data, null, 2);
  } catch (e) { document.getElementById('stateViewer').value = '// Erro: ' + e.message; }
}

document.getElementById('refreshState').onclick = loadStateViewer;

document.getElementById('exportState').onclick = async () => {
  const { data } = await api('/api/estado');
  const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `roleta-config-${Date.now()}.json`;
  a.click();
};

document.getElementById('importStateBtn').onclick = () =>
  document.getElementById('importStateFile').click();

document.getElementById('importStateFile').onchange = async (e) => {
  const file = e.target.files[0];
  if (!file) return;
  const text = await file.text();
  try {
    const json = JSON.parse(text);
    if (!confirm('Substituir todo o estado atual pelo arquivo importado?')) return;
    await api('/api/estado', { method: 'PUT', body: json });
    toast('✅ Estado importado!');
    init();
    loadStateViewer();
  } catch (err) { toast('❌ JSON inválido: ' + err.message, 'err'); }
};

document.getElementById('resetState').onclick = async () => {
  if (!confirm('⚠️ Tem certeza? Isso apaga TODAS as configurações.')) return;
  try {
    await api('/api/estado/reset', { method: 'POST' });
    toast('🔄 Estado resetado!');
    init();
  } catch (e) { toast('❌ ' + e.message, 'err'); }
};

// Auto-login se credenciais salvas
if (savedApi && savedSecret) {
  doLogin(savedApi, savedSecret);
}
</script>
</body>
</html>
