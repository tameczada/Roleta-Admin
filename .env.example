# Copie para ".env" (local) ou cadastre em Render > Environment. NUNCA commite o .env.

# Chave do painel admin. Gere uma forte:  openssl rand -hex 32
ADMIN_SECRET=

# URL do frontend (GitHub Pages) e do próprio backend
FRONTEND_URL=https://SEU_USUARIO.github.io/roleta-leoeisa
BACKEND_URL=https://roleta-admin.onrender.com

# Origens extras liberadas no CORS, separadas por vírgula (opcional)
# EXTRA_ORIGINS=https://minha-roleta.exemplo.com

# Supabase (Project Settings > API) — use a service_role key, NÃO a anon
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# YouTube Data API v3 (opcional — habilita a busca de vídeos do menu YouTube)
YOUTUBE_API_KEY=
